<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- AI 判定（收支识别）所需的网络权限。
         ⚠️ **入口当前是隐藏的**：`AiFeatureGate.ENTRY_VISIBLE = false`
         （app/src/main/java/com/autoledger/app/feature/AiFeatureGate.kt），设置页根本不会渲染这个开关；
         数据侧同样是 `s.aiEnabled && AiFeatureGate.ENTRY_VISIBLE`，即使有人改库把 aiEnabled 打开也不会启用。
         实现与测试完整保留，恢复上线只需把 ENTRY_VISIBLE 改回 true（UI 与数据两侧共用这一个常量）。
         开启后也仅当用户自填接口地址时才会发起请求；关闭状态下应用不产生任何网络流量，
         通知原文也不会离开设备。 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- C4 换机迁移：拉起本地热点（LocalOnlyHotspot）+ 连接热点（WifiNetworkSpecifier） -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 10-12 连接热点需要位置权限；Android 13+ 用 NEARBY_WIFI_DEVICES 替代 -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />

    <application
        android:name=".LedgerApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AutoLedger">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.AutoLedger"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
